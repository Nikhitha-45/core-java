    public static void main(String[] args) {
        for(int i = 1; i <= 40; i++) {
            System.out.println("Table started");
            System.out.println("\nTable of " + i);

            for(int j = 1; j <= 10; j++) {

                System.out.println(i + " x " + j + " = " + (i * j));
            }
            System.out.println("Table ended");
        }
    }
}
